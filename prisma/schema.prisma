// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BotConfig {
  id             String   @id @default(cuid())
  name           String
  strategy       String   // "RSI" | "MACD" | "AI"
  symbol         String   // e.g. "BTCUSDT"
  stopLoss       Float
  takeProfit     Float
  maxDailyTrades Int
  buyThreshold   Float
  sellThreshold  Float
  isActive       Boolean  @default(false)
  mode           String   @default("paper") // "paper" | "live"
  initialBalance Float    @default(10000)
  currentBalance Float    @default(10000)
  apiKey         String?
  apiSecret      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  trades     Trade[]
  portfolios Portfolio[]
}

model Trade {
  id          String   @id @default(cuid())
  botConfigId String?
  symbol      String
  side        String   // "BUY" | "SELL"
  price       Float
  quantity    Float
  total       Float
  strategy    String
  mode        String   // "paper" | "live"
  pnl         Float    @default(0)
  timestamp   DateTime @default(now())

  botConfig BotConfig? @relation(fields: [botConfigId], references: [id])
}

model AISignal {
  id            String   @id @default(cuid())
  symbol        String
  action        String   // "BUY" | "SELL" | "HOLD"
  confidence    Float    // 0-1
  reasoning     String
  priceAtSignal Float
  createdAt     DateTime @default(now())
}

model Portfolio {
  id            String   @id @default(cuid())
  botConfigId   String
  totalValue    Float
  cashBalance   Float
  assetBalance  Float
  assetQuantity Float
  pnl           Float    @default(0)
  pnlPercent    Float    @default(0)
  timestamp     DateTime @default(now())

  botConfig BotConfig @relation(fields: [botConfigId], references: [id])
}

model BacktestResult {
  id             String   @id @default(cuid())
  symbol         String
  strategy       String
  startDate      DateTime
  endDate        DateTime
  initialBalance Float
  finalBalance   Float
  totalTrades    Int
  winRate        Float
  maxDrawdown    Float
  pnl            Float
  pnlPercent     Float
  createdAt      DateTime @default(now())
}

model WatchlistItem {
  id        String   @id @default(cuid())
  symbol    String   @unique
  createdAt DateTime @default(now())
}

model PriceAlert {
  id          String   @id @default(cuid())
  symbol      String
  targetPrice Float
  direction   String   // "above" | "below"
  isTriggered Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Account {
  id             String   @id @default("user-account")
  userId         String   @default("binance_live_user")
  cashBalance    Float    @default(10000.0)
  assetQuantity  Float    @default(0.0)
  symbol         String   @default("BTCUSDT")
  updatedAt      DateTime @updatedAt
}

model NewsEvent {
  id              String        @id @default(cuid())
  title           String
  summary         String
  confidenceScore Float         @default(0.0)
  status          String        @default("DRAFT") // "DRAFT" | "PENDING_REVIEW" | "PUBLISHED" | "REJECTED"
  category        String        @default("Market")
  audioUrl        String?
  subtitleUrl     String?
  videoUrl        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  articles        NewsArticle[]
}

model NewsArticle {
  id          String     @id @default(cuid())
  eventId     String?
  source      String
  sourceUrl   String?
  title       String
  content     String
  publishedAt DateTime
  factScore   Float      @default(0.0)
  createdAt   DateTime   @default(now())
  newsEvent   NewsEvent? @relation(fields: [eventId], references: [id])
}

model UserPreference {
  id            String   @id @default("user_demo_123")
  lang          String   @default("pt-BR")
  themes        String   @default("Market,Regulation")
  preferredHour String   @default("09:00")
  createdAt     DateTime @default(now())
}

// Histórico de candles da Binance baixado localmente (somente candles já fechados).
// A tabela também é criada sob demanda por src/lib/market-history.ts.
model Candle {
  symbol      String
  interval    String
  openTime    Float
  open        Float
  high        Float
  low         Float
  close       Float
  volume      Float
  closeTime   Float
  quoteVolume Float
  trades      Int

  @@id([symbol, interval, openTime])
}

// Registros analíticos do Diário de Trading Institucional (persistência assíncrona em lote via Web Worker + SQLite WAL).
// A tabela e seus índices também são criados sob demanda em src/app/api/journal/sync/route.ts.
model TradeJournalRecord {
  id                String  @id
  botId             String
  botName           String
  symbol            String
  side              String
  mode              String
  strategy          String
  source            String?
  triggerType       String?
  entryPrice        Float
  exitPrice         Float
  quantity          Float
  totalInvested     Float
  totalReturned     Float
  grossPnl          Float
  netPnl            Float
  netGainPercent    Float
  commissionFeesUsd Float
  spreadCostUsd     Float
  highestPrice      Float
  lowestPrice       Float
  maePercent        Float
  mfePercent        Float
  entryTime         String
  exitTime          String
  entryTimestampMs  Float
  exitTimestampMs   Float
  durationMs        Float
  durationMinutes   Float
  durationFormatted String
  exitReason        String
  notes             String?

  @@index([exitTimestampMs])
  @@index([symbol, mode])
}

// Tabela de Agregação Diária Imutável (Daily Rollup & Cold-Tier Columnar Archive)
// Pré-consolida PnL diário, Sharpe, Sortino, Drawdown e blob colunar TJC1 ao final de cada sessão UTC,
// acelerando o carregamento de janelas multi-anuais (1Y/ALL acima de 50.000 execuções) para O(1).
model TradeJournalDailyRollup {
  dateUtc                String
  mode                   String
  totalTrades            Int
  winningTrades          Int
  losingTrades           Int
  grossPnl               Float
  netPnl                 Float
  totalFeesUsd           Float
  totalInvestedUsd       Float
  sumGainPct             Float
  sumGainPctSq           Float
  sumDownsidePctSq       Float
  openingEquity          Float
  closingEquity          Float
  highWaterMarkEquity    Float
  maxIntraDayDrawdownPct Float
  sharpeEstimate         Float
  sortinoEstimate        Float
  isImmutableUtcClosed   Boolean @default(false)
  codec                  String  @default("TJC1_DEFLATE")
  rawBytes               Int     @default(0)
  compactedBytes         Int     @default(0)
  compressionRatio       Float   @default(1.0)
  columnarPayloadBase64  String?
  updatedAtMs            Float

  @@id([dateUtc, mode])
  @@index([dateUtc])
}
